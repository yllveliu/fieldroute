# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=fieldroute
POSTGRES_PASSWORD=fieldroute
POSTGRES_DB=fieldroute
DATABASE_URL=postgresql+psycopg://fieldroute:fieldroute@db:5432/fieldroute

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
SECRET_KEY=fieldroute-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Public URL of the frontend — used in email links (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ── AI Classification ─────────────────────────────────────────────────────────
# Claude API key for AI job classification. Leave empty to use the
# keyword-based fallback classifier. Never commit a real key.
ANTHROPIC_API_KEY=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fieldroute.com
NOTIFICATION_EMAIL=
